{
    "_comment": "Regression test suite for Cyfrowe.pl search engine. Each test defines a query and expected results. Every change to search_engine.py MUST pass all these tests.",
    "_categories": {
        "brand": "Brand recognition and exclusive filtering",
        "brand_typo": "Brand alias/typo resolution (brand_aliases.json)",
        "category": "Category/product type searches",
        "specific": "Specific product model searches",
        "used": "Used/condition filtering",
        "compatibility": "Compatibility queries (do/dla/na/pod prepositions)",
        "lens_notation": "Lens focal length and aperture normalization",
        "ean": "EAN/barcode exact match",
        "availability": "In-stock preference",
        "inflection": "Polish word inflection (prefix matching)",
        "mixed": "Multi-signal queries combining several features"
    },
    "tests": [
        {
            "id": "brand_canon",
            "description": "Searching for a brand should return that brand's products",
            "query": "Canon",
            "expect": {
                "min_results": 10,
                "top_5_must_contain_brand": "Canon",
                "all_must_have_brand": "Canon"
            }
        },
        {
