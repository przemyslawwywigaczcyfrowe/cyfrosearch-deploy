<?xml version="1.0" encoding="UTF-8"?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
            http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="bitbag_sylius_elasticsearch_plugin.query_builder.has_product_taxon"
                 class="App\Component\Elasticsearch\QueryBuilder\HasTaxonQueryBuilder"
        >
            <argument>%bitbag_es_shop_product_taxons_property%</argument>
        </service>

        <service id="bitbag_sylius_elasticsearch_plugin.query_builder.has_option_taxon"
                 class="App\Component\Elasticsearch\QueryBuilder\HasTaxonQueryBuilder"
        >
            <argument>%bitbag_es_shop_option_taxons_property%</argument>
        </service>

        <service id="bitbag_sylius_elasticsearch_plugin.query_builder.has_attribute_taxon"
                 class="App\Component\Elasticsearch\QueryBuilder\HasTaxonQueryBuilder"
        >
            <argument>%bitbag_es_shop_attribute_taxons_property%</argument>
        </service>

        <!-- CHANGED: Added SearchIntentResolver as 3rd argument -->
        <!-- ProductsQueryBuilder now resolves brand/category/condition/focal-length intents -->
        <!-- and builds intent-aware bool queries (match_phrase, constant_score, brand filter) -->
        <service class="App\Component\Elasticsearch\QueryBuilder\ProductsQueryBuilder"
                 id="app.component.elasticsearch.query_builder.products_query_builder"
                 decorates="bitbag_sylius_elasticsearch_plugin.query_builder.site_wide_products"
        >
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.is_enabled" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.has_channel" />
            <argument type="service" id="app.component.elasticsearch.intent_detector.search_intent_resolver" />
            <argument type="string">%bitbag_es_fuzziness%</argument>
            <argument type="string">%elasticsearch.property.state%</argument>
            <argument type="string">%elasticsearch.booster.name%</argument>
            <argument type="string">%elasticsearch.booster.description%</argument>
            <argument type="string">%elasticsearch.booster.producer%</argument>
            <argument type="string">%elasticsearch.booster.main_category%</argument>
            <argument type="string">%elasticsearch.booster.sub_category%</argument>
            <argument type="string">%elasticsearch.booster.child_category%</argument>
        </service>

        <!-- CHANGED: Added bestsellerProperty as 10th argument -->
        <!-- FunctionScoreProductsQueryBuilder now has buildIntentAwareQuery() method -->
        <!-- with 13+ scoring functions including brand boost, main_cat boost, condition switch -->
        <service class="App\Component\Elasticsearch\QueryBuilder\FunctionScoreProductsQueryBuilder"
                 id="app.component.elasticsearch.query_builder.function_score_products_query_builder"
        >
            <argument type="string">%elasticsearch.property.rating%</argument>
            <argument type="string">%elasticsearch.property.featured%</argument>
            <argument type="string">%elasticsearch.property.new_or_promotion%</argument>
            <argument type="string">%elasticsearch.property.popularity%</argument>
            <argument type="string">%elasticsearch.weight.popularity%</argument>
            <argument type="string">%elasticsearch.weight.rating%</argument>
            <argument type="string">%elasticsearch.weight.new_or_promotion%</argument>
            <argument type="string">%elasticsearch.weight.featured%</argument>
            <argument type="string">%elasticsearch.property.product_realization_time_booster%</argument>
            <argument type="string">%elasticsearch.property.bestseller%</argument>
        </service>


        <service class="App\Component\Elasticsearch\QueryBuilder\HasProducerQueryBuilder"
                 id="app.component.elasticsearch.query_builder.has_producer_query_builder"
        >
            <argument type="string">%elasticsearch.property.producer%</argument>
        </service>

        <service class="App\Component\Elasticsearch\QueryBuilder\TaxonsByNameQueryBuilder"
                 id="app.component.elasticsearch.query_builder.taxons_by_name_query_builder"
        >
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.is_enabled" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.contains_name" />
        </service>

        <service class="App\Component\Elasticsearch\QueryBuilder\TaxonProductsQueryBuilder"
                 id="app.component.elasticsearch.query_builder.taxon_products_query_builder"
                 decorates="bitbag_sylius_elasticsearch_plugin.query_builder.taxon_products"
        >
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.is_enabled" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.has_channel" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.contains_name" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.has_product_taxon" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.has_options" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.has_attributes" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.has_price_between" />
            <argument>%bitbag_es_shop_option_property_prefix%</argument>
            <argument>%bitbag_es_shop_attribute_property_prefix%</argument>
            <argument>%elasticsearch.property.state%</argument>
            <argument>%elasticsearch.property.product_realization_time_booster%</argument>
            <argument type="service" id="fos_elastica.finder.bitbag_shop_product" />
        </service>

        <service class="App\Component\Elasticsearch\QueryBuilder\PopularTaxonsQueryBuilder"
                 id="app.component.elasticsearch.query_builder.popular_taxons_query_builder"
        >
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.is_enabled" />
        </service>

        <service class="App\Component\Elasticsearch\QueryBuilder\SaleProductsQueryBuilder"
                 id="app.component.elasticsearch.query_builder.sale_products_query_builder"
        >
            <argument type="string">%elasticsearch.property.is_sale%</argument>
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.is_enabled" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.has_channel" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.contains_name" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.has_price_between" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.has_product_taxon" />
        </service>

        <service class="App\Component\Elasticsearch\QueryBuilder\PopularProductsQueryBuilder"
                 id="app.component.elasticsearch.query_builder.popular_products_query_builder"
        >
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.is_enabled" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.has_channel" />
        </service>

        <service class="App\Component\Elasticsearch\QueryBuilder\FeaturedProductInSearchModalQueryBuilder"
                 id="app.component.elasticsearch.query_builder.featured_product_in_search_modal_query_builder"
        >
            <argument id="bitbag_sylius_elasticsearch_plugin.query_builder.is_enabled" type="service"/>
            <argument id="bitbag_sylius_elasticsearch_plugin.query_builder.has_channel" type="service"/>
            <argument>%elasticsearch.property.is_featured_in_search_modal%</argument>
        </service>

        <!-- CHANGED: SiteWideProductsQueryBuilder now uses concrete ProductsQueryBuilder -->
        <!-- and FunctionScoreProductsQueryBuilder types (not interfaces) to access -->
        <!-- getLastIntent() and buildIntentAwareQuery() methods -->
        <service class="App\Component\Elasticsearch\QueryBuilder\SiteWideProductsQueryBuilder"
                 id="app.component.elasticsearch.query_builder.site_wide_products_query_builder"
        >
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.site_wide_products" />
            <argument type="service" id="fos_elastica.finder.bitbag_shop_product" />
            <argument type="service" id="app.component.elasticsearch.query_builder.function_score_products_query_builder" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.has_price_between" />
        </service>

        <service class="App\Component\Elasticsearch\QueryBuilder\EanAndErpIdProductsQueryBuilder"
                 id="app.component.elasticsearch.query_builder.ean_and_erp_id_products"
        >
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.is_enabled" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.has_channel" />
            <argument type="string">%elasticsearch.property.ean%</argument>
            <argument type="string">%elasticsearch.property.erp_id%</argument>
            <argument type="string">%elasticsearch.property.state%</argument>
        </service>

        <service class="App\Component\Elasticsearch\QueryBuilder\FormQueryBuilder\TaxonFacetsQueryBuilder"
                 id="app.component.elasticsearch.query_builder.form_query_builder.taxon_facets_query_builder"
                 decorates="bitbag_sylius_elasticsearch_plugin.query_builder.taxon_facets"
        >
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.controller.request_data_handler.shop_product_list" />
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.taxon_products" />
<!--            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.facet.registry" />-->
        </service>

        <service class="App\Component\Elasticsearch\QueryBuilder\FormQueryBuilder\SiteWideFacetsQueryBuilder"
                 id="app.component.elasticsearch.query_builder.form_query_builder.site_wide_facets_query_builder"
                 decorates="bitbag_sylius_elasticsearch_plugin.query_builder.site_wide_facets"
        >
            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.query_builder.site_wide_products" />
<!--            <argument type="service" id="bitbag_sylius_elasticsearch_plugin.facet.registry" />-->
        </service>
    </services>
</container>
